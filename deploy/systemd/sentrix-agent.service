[Unit]
Description=SentriX Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sentrix
Group=sentrix
StateDirectory=sentrix
WorkingDirectory=/var/lib/sentrix
EnvironmentFile=/etc/sentrix/agent.env
ExecStart=/opt/sentrix/bin/sentrix-agent
Restart=always
# Exit 78 = credential rejected (revoked or re-enrolled). Restarting cannot fix it.
RestartPreventExitStatus=78
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
